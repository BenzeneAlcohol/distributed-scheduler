{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Scheduler: debug with PostgreSQL in Docker",
      "type": "go",
      "debugAdapter": "dlv-dap",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/scheduler",
      "cwd": "${workspaceFolder}",
      "env": {
        "SCHEDULER_ADDRESS": ":8080",
        "DATABASE_URL": "postgres://scheduler:scheduler@localhost:5432/scheduler?sslmode=disable"
      }
    }
  ]
}
